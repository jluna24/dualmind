# Configuración del servicio DualMind en la Pi.
# Copiar a dualmind.env (no versionado) y llenar los ARN con `tofu -chdir=infra output`.
AWS_PROFILE=dualmind-llm-worker
AWS_REGION=us-east-2
DUALMIND_TABLE=dualmind-telemetry
DUALMIND_DEVICE_ID=esp32-01
# ARN del perfil de inferencia de aplicación: tofu -chdir=infra output llm_profile_arns
DUALMIND_MODEL_ID=arn:aws:bedrock:<region>:<cuenta>:application-inference-profile/<id>
DUALMIND_MODEL_NAME=nova-micro
# Motor de la mente LLM: bedrock (la Pi llama a Bedrock) o agentcore (Fase 3)
DUALMIND_ENGINE=bedrock
# ARN del Runtime: tofu -chdir=infra output agent_runtime_arn
DUALMIND_AGENT_RUNTIME_ARN=
DUALMIND_TZ=America/Tijuana
DUALMIND_INTERVAL_MIN=10
DUALMIND_HISTORY_H=12
# Cámara USB: ruta estable por id (no cambia si se reordenan /dev/videoN)
DUALMIND_CAMERA_DEVICE=/dev/v4l/by-id/usb-046d_C922_Pro_Stream_Webcam_F1AD319F-video-index0
DUALMIND_CAMERA_SIZE=1280x720
DUALMIND_CAMERA_FPS=30
